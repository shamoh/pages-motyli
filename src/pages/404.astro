---
import Base from '../layouts/Base.astro';
---

<Base title="Stránka nenalezena">
  <main class="wrap notfound">
    <p class="eyebrow">404</p>
    <h1>Tady žádný motýl není</h1>
    <p class="lead">Stránka, kterou hledáte, neexistuje.</p>
    <p><a href="/">Zpět na Attacus Imperator →</a></p>
  </main>
</Base>

<style>
  .notfound {
    min-height: 100dvh;
    display: grid;
    align-content: center;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin-bottom: 1rem;
  }
</style>
